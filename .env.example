# Path to Google service account credentials JSON file (optional if using OAuth)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Default GA4 property ID (optional — can also set via: gacli config set property <id>)
GA4_PROPERTY_ID=123456789

# Pre-obtained OAuth access token for agents/CI (optional; wins over every other credential)
# GACLI_ACCESS_TOKEN=ya29....

# Default output format when -f is not given (optional; json is already the default when piped)
# GACLI_FORMAT=json
